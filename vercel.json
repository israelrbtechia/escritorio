{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/agente.js": {
      "maxDuration": 300
    },
    "api/rotina.js": {
      "maxDuration": 300
    },
    "api/meta.js": {
      "maxDuration": 60
    },
    "api/instagram.js": {
      "maxDuration": 300
    },
    "api/saas.js": {
      "maxDuration": 60
    },
    "api/conteudo.js": {
      "maxDuration": 300
    },
    "api/os.js": {
      "maxDuration": 300
    },
    "api/decisoes.js": {
      "maxDuration": 300
    },
    "api/arte.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/saas?revisar=1",
      "schedule": "41 11 * * *"
    },
    {
      "path": "/api/saas?revisar=1",
      "schedule": "41 23 * * *"
    },
    {
      "path": "/api/rotina?equipe=stories&executar=1",
      "schedule": "3 11 * * *"
    },
    {
      "path": "/api/rotina?equipe=reels&executar=1",
      "schedule": "13 11 * * 1"
    },
    {
      "path": "/api/rotina?equipe=trafego&executar=1",
      "schedule": "17 11 * * *"
    },
    {
      "path": "/api/rotina?equipe=trafego&executar=1",
      "schedule": "17 15 * * *"
    },
    {
      "path": "/api/rotina?equipe=trafego&executar=1",
      "schedule": "17 19 * * *"
    },
    {
      "path": "/api/rotina?equipe=trafego&executar=1",
      "schedule": "17 23 * * *"
    },
    {
      "path": "/api/rotina?equipe=crescimento&executar=1",
      "schedule": "27 11 * * *"
    },
    {
      "path": "/api/rotina?equipe=crescimento&executar=1",
      "schedule": "27 15 * * *"
    },
    {
      "path": "/api/rotina?equipe=crescimento&executar=1",
      "schedule": "27 19 * * *"
    },
    {
      "path": "/api/rotina?equipe=crescimento&executar=1",
      "schedule": "27 23 * * *"
    },
    {
      "path": "/api/rotina?equipe=vendas&executar=1",
      "schedule": "37 11 * * *"
    },
    {
      "path": "/api/rotina?equipe=vendas&executar=1",
      "schedule": "37 15 * * *"
    },
    {
      "path": "/api/rotina?equipe=vendas&executar=1",
      "schedule": "37 19 * * *"
    },
    {
      "path": "/api/rotina?equipe=vendas&executar=1",
      "schedule": "37 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/imagem",
      "destination": "/api/arte"
    }
  ]
}
